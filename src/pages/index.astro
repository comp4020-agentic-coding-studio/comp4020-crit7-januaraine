---
import { listSessions } from "../lib/db";
import "../styles.css";

const sessions = listSessions();

// The create route (src/pages/api/sessions.ts) carries the outcome of the
// last add back here via the redirect's query string rather than a second
// round trip: `added` is a comma-separated list of the newly created
// session ids (one per day picked), `clashesWith` is every existing session
// any of them overlaps (kept for backward compatibility with a single add),
// and `clashDetail` maps each added id to *its own* clashing ids
// ("<id>:<clashId1>,<clashId2>;<id>:<clashId3>") so a multi-day submission
// can report the actual conflicting day/session rather than one flat list.
const addedIds = new Set(
  (Astro.url.searchParams.get("added") ?? "")
    .split(",")
    .filter(Boolean)
    .map(Number),
);

const clashesByAddedId = new Map<number, number[]>();
for (const entry of (Astro.url.searchParams.get("clashDetail") ?? "").split(";").filter(Boolean)) {
  const [idPart, clashPart] = entry.split(":");
  const id = Number(idPart);
  const clashIds = (clashPart ?? "").split(",").filter(Boolean).map(Number);
  if (Number.isInteger(id) && clashIds.length > 0) clashesByAddedId.set(id, clashIds);
}

const sessionsById = new Map(sessions.map((s) => [s.id, s]));
const clashGroups = sessions
  .filter((s) => addedIds.has(s.id) && clashesByAddedId.has(s.id))
  .map((added) => ({
    added,
    clashes: (clashesByAddedId.get(added.id) ?? [])
      .map((id) => sessionsById.get(id))
      .filter((s): s is (typeof sessions)[number] => Boolean(s)),
  }));

const DAY_NAMES = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];

function formatTime(minutes: number): string {
  const h = Math.floor(minutes / 60);
  const m = minutes % 60;
  return `${String(h).padStart(2, "0")}:${String(m).padStart(2, "0")}`;
}

function describe(session: (typeof sessions)[number]): string {
  return `${session.courseCode} ${session.activity} — ${DAY_NAMES[session.dayOfWeek]} ${formatTime(session.startMinutes)}–${formatTime(session.endMinutes)}`;
}

// Start/end time is picked as a separate Hour + Minute <select> pair (not one
// combined "HH:MM" dropdown) restricted to 08-21 and :00/:30 — a native
// <input type="time">'s min/max/step attributes don't reliably stop a
// browser's own picker UI from still offering every hour/minute, so discrete
// option lists are what actually enforce the range.
const HOUR_OPTIONS = Array.from({ length: 21 - 8 + 1 }, (_, i) => String(8 + i).padStart(2, "0"));
const MINUTE_OPTIONS = ["00", "30"];

// Grouped by day, sorted by start time within each day — listSessions()
// already returns that order, so grouping is a straight filter, no re-sort.
const sessionsByDay = DAY_NAMES.map((name, day) => ({
  name,
  sessions: sessions.filter((s) => s.dayOfWeek === day),
})).filter((group) => group.sessions.length > 0);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Timetable Clash Resolver</title>
  </head>
  <body>
    <nav aria-label="site" class="site-nav">
      <a href="/">Timetable</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>My Timetable</h1>
      <p class="lede">
        Add each weekly class session — lecture, tutorial, lab — and this
        checks it against every session you've already added. An overlap on
        the same day is flagged straight away; you decide which side to keep.
      </p>

      {
        clashGroups.length > 0 && (
          <div class="clash-banner card" role="alert">
            <h2>Clash detected</h2>
            <p>
              {clashGroups.length === 1
                ? "The session you just added overlaps an existing one:"
                : `${clashGroups.length} of the sessions you just added overlap existing ones:`}
            </p>
            {clashGroups.map((group) => (
              <div class="clash-group">
                <p class="clash-group-heading">
                  {describe(group.added)} overlaps {group.clashes.length} existing session{group.clashes.length > 1 ? "s" : ""}:
                </p>
                <ul class="clash-list">
                  <li class="clash-item">
                    <span class="session-meta">{describe(group.added)} (just added)</span>
                    <form method="post" action={`/api/sessions/${group.added.id}/delete`} class="inline-form">
                      <button class="btn btn-danger-outline" type="submit">Remove this one</button>
                    </form>
                  </li>
                  {group.clashes.map((session) => (
                    <li class="clash-item">
                      <span class="session-meta">{describe(session)}</span>
                      <form method="post" action={`/api/sessions/${session.id}/delete`} class="inline-form">
                        <button class="btn btn-danger-outline" type="submit">Remove this one</button>
                      </form>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )
      }

      <section class="card add-session-card">
        <h2>Add a session</h2>
        <form method="post" action="/api/sessions" id="add-session-form" class="session-form">
          <div class="field">
            <label for="course_code">Course code</label>
            <input id="course_code" name="course_code" required maxlength="40" placeholder="COMP4020" />
          </div>

          <div class="field">
            <label for="activity">Activity</label>
            <select id="activity" name="activity" required>
              <option>Lecture</option>
              <option>Tutorial</option>
              <option>Lab</option>
              <option>Seminar</option>
            </select>
          </div>

          <fieldset class="field days-field">
            <legend>Days</legend>
            <div class="days-inputs">
              <label class="day-checkbox">
                <input type="checkbox" name="day_of_week" value="0" />
                <span>Mon</span>
              </label>
              <label class="day-checkbox">
                <input type="checkbox" name="day_of_week" value="1" />
                <span>Tue</span>
              </label>
              <label class="day-checkbox">
                <input type="checkbox" name="day_of_week" value="2" />
                <span>Wed</span>
              </label>
              <label class="day-checkbox">
                <input type="checkbox" name="day_of_week" value="3" />
                <span>Thu</span>
              </label>
              <label class="day-checkbox">
                <input type="checkbox" name="day_of_week" value="4" />
                <span>Fri</span>
              </label>
            </div>
          </fieldset>

          <fieldset class="field time-field">
            <legend>Start time</legend>
            <div class="time-inputs">
              <div class="time-part">
                <label for="start_hour" class="sr-only">Start hour</label>
                <select id="start_hour" required>
                  <option value="" disabled selected>HH</option>
                  {HOUR_OPTIONS.map((h) => <option value={h}>{h}</option>)}
                </select>
              </div>
              <span class="time-sep">:</span>
              <div class="time-part">
                <label for="start_minute" class="sr-only">Start minute</label>
                <select id="start_minute" required>
                  <option value="" disabled selected>MM</option>
                  {MINUTE_OPTIONS.map((m) => <option value={m}>{m}</option>)}
                </select>
              </div>
            </div>
          </fieldset>

          <fieldset class="field time-field">
            <legend>End time</legend>
            <div class="time-inputs">
              <div class="time-part">
                <label for="end_hour" class="sr-only">End hour</label>
                <select id="end_hour" required>
                  <option value="" disabled selected>HH</option>
                  {HOUR_OPTIONS.map((h) => <option value={h}>{h}</option>)}
                </select>
              </div>
              <span class="time-sep">:</span>
              <div class="time-part">
                <label for="end_minute" class="sr-only">End minute</label>
                <select id="end_minute" required>
                  <option value="" disabled selected>MM</option>
                  {MINUTE_OPTIONS.map((m) => <option value={m}>{m}</option>)}
                </select>
              </div>
            </div>
          </fieldset>

          <input type="hidden" name="start_minutes" id="start_minutes" />
          <input type="hidden" name="end_minutes" id="end_minutes" />

          <div class="form-actions">
            <button class="btn btn-primary" type="submit">Add session</button>
          </div>
        </form>
      </section>

      <h2>Your timetable</h2>
      {
        sessionsByDay.length === 0 ? (
          <p class="empty-state">No sessions yet — add one above.</p>
        ) : (
          <div class="timetable-groups">
            {sessionsByDay.map((group) => (
              <section class="card day-card">
                <h3>
                  {group.name} <span class="day-count">{group.sessions.length}</span>
                </h3>
                <ul class="session-list">
                  {group.sessions.map((session) => (
                    <li class="session-row">
                      <span class="session-meta">
                        {session.courseCode} {session.activity} ({formatTime(session.startMinutes)}–{formatTime(session.endMinutes)})
                      </span>
                      <form method="post" action={`/api/sessions/${session.id}/delete`} class="inline-form">
                        <button class="btn btn-danger-outline" type="submit">Remove</button>
                      </form>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        )
      }
    </main>
    <script>
      // The add-session form's time pickers are the friendliest widget for
      // "start time" / "end time", but the API (src/pages/api/sessions.ts)
      // takes minutes-since-midnight integers, matching how they're stored
      // and compared (see src/lib/schema.ts). This converts one to the
      // other right before submit. Without JS the hidden fields stay empty
      // and the server rejects the POST with a clear 400 rather than saving
      // a wrong value.
      const form = document.querySelector("#add-session-form");
      const dayInputs = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="day_of_week"]'));
      form?.addEventListener("submit", (event) => {
        // A checkbox group has no native "at least one required" the way a
        // single <select required> does, so this is checked by hand. Without
        // JS the check never runs and a zero-day POST still reaches the
        // server, which rejects it with 400 — the same fallback the rest of
        // this form already relies on.
        const anyDayChecked = dayInputs.some((input) => input.checked);
        dayInputs[0]?.setCustomValidity(anyDayChecked ? "" : "Select at least one day.");
        if (!anyDayChecked) {
          event.preventDefault();
          dayInputs[0]?.reportValidity();
          return;
        }

        const setMinutes = (hourId: string, minuteId: string, hiddenId: string) => {
          const hour = document.querySelector<HTMLSelectElement>(hourId)?.value;
          const minute = document.querySelector<HTMLSelectElement>(minuteId)?.value;
          const hiddenField = document.querySelector<HTMLInputElement>(hiddenId);
          if (hour && minute && hiddenField) {
            hiddenField.value = String(Number(hour) * 60 + Number(minute));
          }
        };
        setMinutes("#start_hour", "#start_minute", "#start_minutes");
        setMinutes("#end_hour", "#end_minute", "#end_minutes");
      });
    </script>
  </body>
</html>
